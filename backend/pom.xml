<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.materia</groupId>
    <artifactId>materia-backend</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>materia-backend</name>
    <description>
        The Materia backend: the shared libraries and the services built on them (see
        docs/architecture/modular-monolith.md).
    </description>

    <modules>
        <!-- Shared kernel: money, base types, outbox and inbox, audit, attachments, FX. Knows no context. -->
        <module>materia-common</module>
        <!-- gRPC contracts between the services (.proto), their generated stubs, and the interceptors they share. -->
        <module>materia-grpc</module>
        <!-- What every service runs on: security chain, error handling, token keys, database and Kafka setup. -->
        <module>materia-platform</module>
        <!-- The test infrastructure every service's tests share (test scope only). -->
        <module>materia-test-support</module>
        <!-- Today's application: every context in one deployable, extracted service by service. -->
        <module>procurement-service</module>
        <!-- Identity: accounts, sign-in, tokens and employees; the only signer of tokens. -->
        <module>identity-service</module>
        <!-- Master data: materials, categories, suppliers and stock. -->
        <module>masterdata-service</module>
        <!-- Finance: invoices, payments and their settings. -->
        <module>finance-service</module>
        <!-- Analytics: the dashboard, composed from the other services' figures. -->
        <module>analytics-service</module>
        <!-- The API gateway: the only way in from outside, in front of the services. -->
        <module>gateway-service</module>
    </modules>

    <properties>
        <!--
          Security patches above the versions Spring Boot 3.5.16 manages, each a patch release of the same line, for
          vulnerabilities the CI scans report (Trivy). Remove a line once Spring Boot manages that version or newer.
        -->
        <postgresql.version>42.7.12</postgresql.version>
        <netty.version>4.1.137.Final</netty.version>
        <tomcat.version>10.1.60</tomcat.version>
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <java.version>21</java.version>
        <testcontainers.version>1.21.3</testcontainers.version>
        <jacoco.version>0.8.12</jacoco.version>
        <lombok.version>1.18.42</lombok.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.8.9</springdoc.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- gRPC and the protobuf compiler that matches it (grpc-java 1.75 is built against protobuf 3.25.8). 1.75 fixes
             CVE-2025-55163 (HTTP/2 "MadeYouReset" in grpc-netty-shaded), which the CI image scans fail on. -->
        <grpc.version>1.75.0</grpc.version>
        <protobuf.version>3.25.8</protobuf.version>
        <!-- Lets modules without a JaCoCo agent use @{argLine} in the Surefire configuration below. -->
        <argLine/>
        <!-- Libraries have nothing to run: `./mvnw -pl procurement-service -am spring-boot:run` starts procurement only. -->
        <spring-boot.run.skip>true</spring-boot.run.skip>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.materia</groupId>
                <artifactId>materia-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.materia</groupId>
                <artifactId>materia-grpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.materia</groupId>
                <artifactId>materia-platform</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.materia</groupId>
                <artifactId>materia-test-support</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Brought in by kafka-clients; 1.11.4 fixes a HIGH vulnerability of 1.10.1. -->
            <dependency>
                <groupId>at.yawk.lz4</groupId>
                <artifactId>lz4-java</artifactId>
                <version>1.11.4</version>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-common</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>21</release>
                        <source>21</source>
                        <target>21</target>
                        <proc>full</proc>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <!--
                  Coverage is measured on business logic only. Each module runs these executions on its own data;
                  a module without tests has no data and skips them.
                -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>**/dtos/**</exclude>
                            <exclude>**/config/**</exclude>
                            <exclude>**/*JpaEntity*</exclude>
                            <exclude>**/mappers/**</exclude>
                            <exclude>**/*Application.class</exclude>
                            <!-- Code generated from the .proto contracts -->
                            <exclude>com/materia/proto/**</exclude>
                        </excludes>
                    </configuration>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <!--
                          CI runs unit and integration tests as separate jobs, each writing its own
                          jacoco-*.exec; this merges them into jacoco.exec so the report and the gate
                          below see the combined coverage (mvn jacoco:merge@merge-ci).
                        -->
                        <execution>
                            <id>merge-ci</id>
                            <goals>
                                <goal>merge</goal>
                            </goals>
                            <configuration>
                                <fileSets>
                                    <fileSet>
                                        <directory>${project.build.directory}</directory>
                                        <includes>
                                            <include>jacoco-*.exec</include>
                                        </includes>
                                    </fileSet>
                                </fileSets>
                                <destFile>${project.build.directory}/jacoco.exec</destFile>
                            </configuration>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                        <!--
                          T120 – 80% branch coverage enforced on domain and application packages.
                          Infrastructure (adapters, JPA entities) is intentionally excluded.
                        -->
                        <execution>
                            <id>check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                            <configuration>
                                <rules>
                                    <rule>
                                        <element>PACKAGE</element>
                                        <!--
                                          Only contexts that have verification are gated (002 research F-009).
                                          Add a context here when it gets tests; invoice, payement and
                                          returnToVendor are untested and would fail at 0%.
                                        -->
                                        <includes>
                                            <include>com.materia.backend.contexts.auth.domain.*</include>
                                            <include>com.materia.backend.contexts.auth.application.*</include>
                                            <include>com.materia.backend.contexts.employee.domain.*</include>
                                            <include>com.materia.backend.contexts.employee.application.*</include>
                                            <include>com.materia.backend.contexts.masterData.domain.*</include>
                                            <include>com.materia.backend.contexts.masterData.application.*</include>
                                            <include>com.materia.backend.contexts.purchaseRequisition.domain.*</include>
                                            <include>com.materia.backend.contexts.purchaseRequisition.application.*</include>
                                            <include>com.materia.backend.contexts.purchaseOrder.domain.*</include>
                                            <include>com.materia.backend.contexts.purchaseOrder.application.*</include>
                                            <include>com.materia.backend.contexts.goodsReceipt.domain.*</include>
                                            <include>com.materia.backend.contexts.goodsReceipt.application.*</include>
                                        </includes>
                                        <limits>
                                            <limit>
                                                <counter>BRANCH</counter>
                                                <value>COVEREDRATIO</value>
                                                <minimum>0.80</minimum>
                                            </limit>
                                        </limits>
                                    </rule>
                                </rules>
                            </configuration>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!--
              Results must not depend on the machine that runs them (FR-011, FR-012):
              - time zone and locale are pinned rather than inherited from the host;
              - SPRING_PROFILES_ACTIVE resolves the base application.properties
                placeholder, which has no default and would otherwise fail to resolve,
                so every test runs under the test profile without needing
                @ActiveProfiles on each class.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Duser.timezone=UTC -Duser.language=en -Duser.country=US</argLine>
                    <trimStackTrace>false</trimStackTrace>
                    <!--
                      *IT.java names the Docker-backed integration tests. Surefire ignores that
                      suffix by default, so it is listed explicitly, or those tests would be
                      silently skipped by `mvn test`. Run only them with -Dtest='*IT'.
                    -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <SPRING_PROFILES_ACTIVE>test</SPRING_PROFILES_ACTIVE>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>

            <!--
              Lint (mvn checkstyle:check): defects and dead code only, see config/checkstyle/checkstyle.xml.
              One configuration for every module, found from the reactor root.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
                    <consoleOutput>true</consoleOutput>
                    <failOnViolation>true</failOnViolation>
                    <violationSeverity>error</violationSeverity>
                    <includeTestSourceDirectory>false</includeTestSourceDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
