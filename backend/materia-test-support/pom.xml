<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.materia</groupId>
        <artifactId>materia-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>materia-test-support</artifactId>
    <name>materia-test-support</name>
    <description>
        The test infrastructure every service's tests share (a test dependency only): the integration-test base with
        its PostgreSQL container, the web-slice base, the Docker rule, test token keys, an in-process gRPC channel and
        the common assertions. Context fixtures stay with their service.
    </description>

    <dependencies>
        <dependency>
            <groupId>com.materia</groupId>
            <artifactId>materia-platform</artifactId>
        </dependency>
        <dependency>
            <groupId>com.materia</groupId>
            <artifactId>materia-grpc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
    </dependencies>
</project>
