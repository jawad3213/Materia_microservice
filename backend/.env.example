# ===================================================================
# Secrets & Environment Connections (.env.example)
# ===================================================================
SPRING_PROFILES_ACTIVE=dev

# Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/materia
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Kafka & Messaging Configuration
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
APP_MESSAGING_TYPE=spring

# Swagger / OpenAPI Configuration
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui.html
SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_INFO_TITLE=Materia Backend API
SPRINGDOC_INFO_DESCRIPTION=RESTful API documentation for Materia Backend application
SPRINGDOC_INFO_VERSION=1.0.0
SPRINGDOC_INFO_CONTACT_NAME=Materia Team
SPRINGDOC_INFO_CONTACT_EMAIL=support@materia.com
SWAGGER_UI_URL=http://localhost:8080/swagger-ui.html

# JWT Security Configuration
# RS256 key pair, each as the Base64 of its PEM (one line). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.pem
#   echo "JWT_PRIVATE_KEY=$(base64 -w0 jwt.pem)"
#   echo "JWT_PUBLIC_KEY=$(openssl pkey -in jwt.pem -pubout | base64 -w0)"
JWT_PRIVATE_KEY=your_base64_pem_pkcs8_private_key
JWT_PUBLIC_KEY=your_base64_pem_public_key
# Access tokens are validated statelessly by the gateway, so a revoked user keeps
# access until the current token expires. Keep this window short (15 min).
JWT_EXPIRATION_MS=900000

# Security & CORS Configuration
APP_SECURITY_PUBLIC_ENDPOINTS=/api/v1/auth/login,/api/v1/auth/refresh,/api/v1/auth/logout,/api/v1/auth/forgot-password,/api/v1/auth/reset-password,/swagger-ui/**,/swagger-ui.html,/v3/api-docs/**,/actuator/health,/actuator/health/**,/actuator/info,/error
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email / SMTP Configuration (e.g. Gmail, Mailtrap, SendGrid)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_email@gmail.com
SPRING_MAIL_PASSWORD=your_google_app_password
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=noreply@materia.com
APP_RESET_PASSWORD_URL=http://localhost:5173/reset-password
APP_LOGIN_URL=http://localhost:5173/signin

# ExchangeRate-API Configuration
EXCHANGE_BASE_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_API_KEY=your_exchange_rate_api_key
EXCHANGE_CACHE_TTL_MINUTES=60
EXCHANGE_TIMEOUT_MS=5000


# First administrator, created on the first start while no account exists (must change the password at first sign-in)
APP_BOOTSTRAP_ADMIN_EMAIL=admin@materia.local
APP_BOOTSTRAP_ADMIN_PASSWORD=Change.Me-2026!

# Dev demo data (dev profile only): accounts admin@/purchaser@/receiver@materia.com, master data,
# requisitions and orders, created on start-up into an empty database. false to start empty.
APP_SEED_DEMO_DATA=true
APP_SEED_PASSWORD=Materia.Dev1!
