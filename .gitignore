# Backend ignored resources
# Flyway migrations are tracked: every environment needs them to build its schema.
# The users migration seeds default accounts with password hashes; it stays local until
# those accounts are created another way.
backend/procurement-service/src/main/resources/db/migration/V20260922_01__create_users_table.sql
backend/*/src/main/resources/META-INF/



# CD test results (k6, OWASP ZAP), written by local runs
tests/performance/results/
tests/security/zap/results/
