# ===================================================================
# DOCKER COMPOSE ENVIRONMENT VARIABLES (.env.example)
# ===================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=materia
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_PORT=5432
# Each service's own database user (aws/deploy/db/service-roles.sql); unset, local-only defaults are used
DB_PASSWORD_IDENTITY=
DB_PASSWORD_MASTERDATA=
DB_PASSWORD_PROCUREMENT=
DB_PASSWORD_FINANCE=
DB_PASSWORD_ANALYTICS=

# Apache Kafka Configuration
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# Kafka UI Configuration
KAFKA_UI_PORT=8085
KAFKA_CLUSTER_NAME=materia-cluster

# Backend Service Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Events travel through Kafka between services (master data keeps stock from procurement's events), so the stack
# always runs with the broker: docker-compose.yml sets the messaging for each service.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Identity Service Configuration (sign-in, accounts, employees; the only signer of tokens)
IDENTITY_PORT=8082
# The secrets the backend and master data present to identity for their service tokens (long random strings)
SERVICE_CLIENT_MONOLITH_SECRET=change_me_to_a_long_random_secret
SERVICE_CLIENT_MASTERDATA_SECRET=change_me_to_another_long_random_secret
SERVICE_CLIENT_FINANCE_SECRET=change_me_to_a_third_long_random_secret
SERVICE_CLIENT_ANALYTICS_SECRET=change_me_to_a_fourth_long_random_secret

# Master Data Service Configuration (materials, categories, suppliers, stock)
MASTERDATA_PORT=8083

# Finance Service Configuration (invoices, payments, settings)
FINANCE_PORT=8084

# Analytics Service Configuration (the dashboard)
ANALYTICS_PORT=8085

# API gateway (the only way in: it routes sign-in and employees to identity, the rest to the backend)
GATEWAY_PORT=8090

# Frontend Service Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8090/api/v1

# Security / JWT Keys
# RS256 key pair, each as the Base64 of its PEM (see backend/.env.example for how to generate them).
# Identity signs with the private key; the other services only get the public one.
JWT_PRIVATE_KEY=your_base64_pem_pkcs8_private_key
JWT_PUBLIC_KEY=your_base64_pem_public_key

# ExchangeRate-API Configuration (https://www.exchangerate-api.com)
EXCHANGE_BASE_URL=https://v6.exchangerate-api.com/v6
EXCHANGE_API_KEY=your_exchangerate_api_key_here


# First administrator, created on the first start while no account exists (must change the password at first sign-in)
APP_BOOTSTRAP_ADMIN_EMAIL=admin@materia.local
APP_BOOTSTRAP_ADMIN_PASSWORD=Change.Me-2026!

# Dev demo data (dev profile only): accounts admin@/purchaser@/receiver@materia.com, master data,
# requisitions and orders, created on start-up into an empty database. false to start empty.
APP_SEED_DEMO_DATA=true
APP_SEED_PASSWORD=Materia.Dev1!
