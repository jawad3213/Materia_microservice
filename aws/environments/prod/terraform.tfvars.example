# Copy to terraform.tfvars (git-ignored) and adjust.

aws_region  = "eu-west-3"
project     = "materia"
environment = "prod"

# Network (different range from staging)
vpc_cidr            = "10.30.0.0/16"
public_subnet_cidrs = ["10.30.1.0/24", "10.30.2.0/24"]
allowed_http_cidrs  = ["0.0.0.0/0"]

# Instance
instance_type           = "t3.large"
root_volume_size        = 40
data_volume_size        = 50
detailed_monitoring     = true
enable_snapshots        = true
snapshot_retention_days = 14

# Images
ecr_keep_images  = 20
ecr_force_delete = false

# GitHub OIDC (outputs of aws/bootstrap)
github_oidc_provider_arn = "arn:aws:iam::<account-id>:oidc-provider/token.actions.githubusercontent.com"
github_repository        = "jawad3213/materia"
github_environment       = "production"

# Production deploys the images validated in staging, copied unchanged from staging's repositories.
promote_from_environment = "staging"

# Application
spring_profile        = "prod"
app_url               = "" # e.g. "https://app.example.com": Keycloak's sign-in needs HTTPS (see aws/README.md)
# true only to run the smoke test's signed-in checks here (password grant client materia-test-runner)
keycloak_test_client_enabled = false
contact_email         = "support@example.com"
bootstrap_admin_email = "admin@example.com" # first administrator; read its password with the bootstrap_admin_password_command output

app_config = {
  # SPRING_MAIL_HOST     = "smtp.example.com"
  # SPRING_MAIL_PORT     = "587"
  # SPRING_MAIL_USERNAME = "no-reply@example.com"
  # APP_MAIL_FROM        = "no-reply@example.com"
}

# Never commit real values; terraform.tfvars is git-ignored.
extra_secrets = {
  # First administrator, created on the first start while no account exists (remove after first sign-in):
  # APP_BOOTSTRAP_ADMIN_EMAIL    = "admin@example.com"
  # APP_BOOTSTRAP_ADMIN_PASSWORD = "Change-me-1!"
  # SPRING_MAIL_PASSWORD = "..."
  # EXCHANGE_API_KEY     = "..."
}
