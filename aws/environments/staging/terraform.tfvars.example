# Copy to terraform.tfvars (git-ignored) and adjust.

aws_region  = "eu-west-3"
project     = "materia"
environment = "staging"

# Network
vpc_cidr            = "10.20.0.0/16"
public_subnet_cidrs = ["10.20.1.0/24", "10.20.2.0/24"]
allowed_http_cidrs  = ["0.0.0.0/0"] # e.g. ["203.0.113.10/32"] to restrict staging

# Instance
instance_type           = "t3.medium"
root_volume_size        = 30
data_volume_size        = 20
enable_snapshots        = true
snapshot_retention_days = 3

# Images
ecr_keep_images  = 10
ecr_force_delete = true

# GitHub OIDC (outputs of aws/bootstrap)
github_oidc_provider_arn = "arn:aws:iam::<account-id>:oidc-provider/token.actions.githubusercontent.com"
github_repository        = "jawad3213/materia"
github_environment       = "staging"

# Application
spring_profile        = "staging"
app_url               = "" # empty = http://<elastic ip>; Keycloak's sign-in needs https:// (see aws/README.md, HTTPS)
# The CD's tests sign in through the realm's materia-test-runner client (password grant)
keycloak_test_client_enabled = true

# The CD performance test sends a few thousand requests a minute from one GitHub runner: raise the per-client
# quota here (prod keeps the default of 120).
api_rate_limit_per_minute = 6000
contact_email         = "support@example.com"
bootstrap_admin_email = "admin@example.com" # first administrator; read its password with the bootstrap_admin_password_command output

app_config = {
  # SPRING_MAIL_HOST     = "smtp.example.com"
  # SPRING_MAIL_PORT     = "587"
  # SPRING_MAIL_USERNAME = "no-reply@example.com"
  # APP_MAIL_FROM        = "no-reply@example.com"
}

# Never commit real values; terraform.tfvars is git-ignored.
extra_secrets = {
  # First administrator, created on the first start while no account exists (remove after first sign-in):
  # APP_BOOTSTRAP_ADMIN_EMAIL    = "admin@example.com"
  # APP_BOOTSTRAP_ADMIN_PASSWORD = "Change-me-1!"
  # SPRING_MAIL_PASSWORD = "..."
  # EXCHANGE_API_KEY     = "..."
}
