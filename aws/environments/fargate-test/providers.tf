# ===================================================================
# Fargate test environment - providers.tf
# A throwaway environment: brought up to try the services on ECS Fargate, then destroyed. Its state stays local
# (terraform.tfstate in this directory, ignored by git), so it needs nothing from aws/bootstrap.
# ===================================================================

terraform {
  required_version = ">= 1.10.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
    tls = {
      source  = "hashicorp/tls"
      version = "~> 4.0"
    }
  }
}

provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Project     = var.project
      Environment = var.environment
      ManagedBy   = "Terraform"
    }
  }
}
