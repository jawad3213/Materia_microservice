{
  "realm": "materia",
  "displayName": "Materia",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "registrationEmailAsUsername": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 900,
  "passwordPolicy": "length(8) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1)",
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administrateur: Accès complet au système",
        "composite": true,
        "composites": {
          "client": {
            "materia-api": [
              "category:delete",
              "category:read",
              "category:write",
              "dashboard:export",
              "dashboard:read",
              "invoice:read",
              "invoice:validate",
              "invoice:write",
              "log:export",
              "log:read",
              "material:delete",
              "material:read",
              "material:stock:read",
              "material:stock:write",
              "material:write",
              "order:cancel",
              "order:read",
              "order:validate",
              "order:write",
              "payment:read",
              "payment:write",
              "receipt:quality",
              "receipt:read",
              "receipt:write",
              "requisition:convert",
              "requisition:read",
              "requisition:validate",
              "requisition:write",
              "return:read",
              "return:write",
              "setting:read",
              "setting:write",
              "supplier:delete",
              "supplier:read",
              "supplier:write",
              "user:delete",
              "user:read",
              "user:write"
            ]
          }
        }
      },
      {
        "name": "PURCHASER",
        "description": "Acheteur: Gestion des achats",
        "composite": true,
        "composites": {
          "client": {
            "materia-api": [
              "category:read",
              "category:write",
              "dashboard:read",
              "invoice:read",
              "invoice:write",
              "material:read",
              "material:write-price",
              "order:cancel",
              "order:read",
              "order:write",
              "payment:read",
              "receipt:read",
              "requisition:convert",
              "requisition:read",
              "requisition:validate",
              "requisition:write",
              "return:read",
              "return:write",
              "supplier:read",
              "supplier:write"
            ]
          }
        }
      },
      {
        "name": "RECEIVER",
        "description": "Réceptionnaire: Gestion des stocks et réceptions",
        "composite": true,
        "composites": {
          "client": {
            "materia-api": [
              "category:read",
              "dashboard:read",
              "material:read",
              "material:stock:read",
              "material:stock:write",
              "order:read",
              "receipt:quality",
              "receipt:read",
              "receipt:write",
              "requisition:read",
              "return:read",
              "return:write",
              "supplier:read"
            ]
          }
        }
      },
      {
        "name": "SERVICE",
        "description": "A Materia service acting for itself (client credentials), never a user"
      }
    ],
    "client": {
      "materia-api": [
        {
          "name": "category:delete"
        },
        {
          "name": "category:read"
        },
        {
          "name": "category:write"
        },
        {
          "name": "dashboard:export"
        },
        {
          "name": "dashboard:read"
        },
        {
          "name": "invoice:read"
        },
        {
