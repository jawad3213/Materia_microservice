        {
          "name": "return:write"
        },
        {
          "name": "setting:read"
        },
        {
          "name": "setting:write"
        },
        {
          "name": "supplier:delete"
        },
        {
          "name": "supplier:read"
        },
        {
          "name": "supplier:write"
        },
        {
          "name": "user:delete"
        },
        {
          "name": "user:read"
        },
        {
          "name": "user:write"
        }
      ]
    }
