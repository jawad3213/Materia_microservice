        {
          "name": "material:write-price"
        },
        {
          "name": "order:cancel"
        },
        {
          "name": "order:read"
        },
        {
          "name": "order:validate"
        },
        {
          "name": "order:write"
        },
        {
          "name": "payment:read"
        },
        {
          "name": "payment:write"
        },
        {
          "name": "receipt:quality"
        },
        {
          "name": "receipt:read"
        },
        {
          "name": "receipt:write"
        },
        {
          "name": "requisition:convert"
        },
        {
          "name": "requisition:read"
        },
        {
          "name": "requisition:validate"
